<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Meridian Atelier</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>Ink</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Meridian connects to your Mac’s local Atelier API while developing Club features.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Meridian Atelier uses Face ID to unlock your Club session after email verification.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Meridian uses your location to suggest nearby hotels, beaches, and resorts for local celebrations.</string>
	<key>MeridianAPIHost</key>
	<string></string>
</dict>
</plist>
